# magpie, the local AI gateway that serves every model call (https://github.com/yetone/magpie).
MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
MAGPIE_API_KEY=magpie
# Optional overrides for the PDF page reader (scans and hard layouts).
# MAGPIE_VISION_MODEL=opencode-go/qwen3.8-flash
# MAGPIE_LAYOUT_MODEL=

# Exa web search, for Fact-check. Optional: without it answers stay inside the text.
EXA_API_KEY=

# The public origin, for canonical and social card URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# The SQLite sync database's directory. The desktop shell always passes
# ASKBOOK_DATA_DIR itself (its userData dir), so this only matters to
# `next dev`. Set it to the same path the desktop build uses — %APPDATA%\askbook
# on Windows — so a dev server and a packaged app on one machine share the data.
# ASKBOOK_DATA_DIR=%APPDATA%/askbook

# The packaged app's own server port. `next dev` is on 3100; the desktop shell
# forks its server on ASKBOOK_PORT (default 4100), so dev and a packaged app
# can run at once without either claiming the other's port.
# ASKBOOK_PORT=4100
