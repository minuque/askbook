# magpie, the local AI gateway that serves every model call (https://github.com/yetone/magpie).
MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
MAGPIE_API_KEY=magpie
# Optional overrides for the PDF page reader (scans and hard layouts).
# MAGPIE_VISION_MODEL=opencode-go/qwen3.8-flash
# MAGPIE_LAYOUT_MODEL=

# Exa web search, for Fact-check. Optional: without it answers stay inside the text.
EXA_API_KEY=

# The public origin, for canonical and social card URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
