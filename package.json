{
  "name": "askbook",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "tsc --noEmit",
    "electron:dev": "electron .",
    "release": "node -e \"fs.rmSync('.next',{recursive:true,force:true})\" && next build && node scripts/copy-standalone-assets.mjs && node scripts/electron-builder-env.mjs && electron-builder --dir --publish never --config.directories.output=release",
    "dist": "npm run build && node scripts/copy-standalone-assets.mjs && electron-builder"
  },
  "dependencies": {
    "@llamaindex/liteparse-wasm": "2.15.1",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
